# Gmail account used to send contact form emails
EMAIL_USER=your-gmail-address@gmail.com

# Gmail App Password (not your regular Gmail password)
# Generate one at: https://myaccount.google.com/apppasswords
EMAIL_PASS=your-gmail-app-password

# Address that receives the contact form submissions
EMAIL_TO=your-receiving-address@gmail.com

# Port for the local Express server (api/contact.ts uses Vercel, server/ uses this)
PORT=5000
